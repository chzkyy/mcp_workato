# =============================================================================
# Workato MCP Server - Configuration
# =============================================================================
# Copy this file to ".env" and fill in your values, OR set these as
# environment variables in your claude_desktop_config.json "env" block.
#
# The server supports THREE authentication methods (pick ONE):
#
# METHOD 1: API Token (simplest - recommended) ⭐
#   - Only needs the token from the API Clients page.
#   - Sent as: Authorization: Bearer <token>
#   - Required: WORKATO_TOKEN  (only)
#   - Get it from: https://app.<pod>.workato.com/members/api/clients
#                  (e.g. https://app.sg.workato.com/members/api/clients)
#
# METHOD 2: API Client / OAuth2
#   - Exchanges client_id + client_secret for a Bearer access token.
#   - Required: WORKATO_CLIENT_ID + WORKATO_CLIENT_SECRET
#   - Get these from: Workato → Tools → API Clients (or App Console)
#
# METHOD 3: Access Token (legacy personal API token)
#   - Uses headers: x-client-secret (token) + x-user-id
#   - Required: WORKATO_TOKEN + WORKATO_USER_ID
#   - Get these from: Workato → Settings → Account → API Tokens
#
# Auto-detection order:
#   1. WORKATO_AUTH_MODE set              -> use that mode
#   2. WORKATO_CLIENT_ID set              -> oauth2
#   3. WORKATO_TOKEN + WORKATO_USER_ID    -> access_token (legacy)
#   4. WORKATO_TOKEN only                 -> api_token (default)
# =============================================================================

# ---- Auth mode (optional, auto-detected) ------------------------------------
# WORKATO_AUTH_MODE=api_token     # or: access_token | oauth2

# ---- METHOD 1 & 3: API token / access token ---------------------------------
# This single token is enough for METHOD 1 (api_token mode, the default).
# For METHOD 3 (access_token mode) you also need WORKATO_USER_ID below.
# WORKATO_TOKEN=
# WORKATO_USER_ID=

# ---- METHOD 2: API Client / OAuth2 credentials ------------------------------
# WORKATO_CLIENT_ID=
# WORKATO_CLIENT_SECRET=

# ---- Data center / pod (optional, default: us) ------------------------------
# Options: us, eu, sg, jp, au, il, kr, cn, trial
# Tip: match the pod in your Workato URL, e.g. app.sg.workato.com -> sg
# WORKATO_POD=sg

# ---- Override base URLs (optional, overrides pod) ---------------------------
# WORKATO_BASE_URL=https://www.workato.com
# WORKATO_TOKEN_URL=https://www.workato.com/oauth/token

# ---- Request timeout in milliseconds (optional, default: 60000) -------------
# WORKATO_TIMEOUT_MS=60000

# ---- Debug logging (optional, default: false) -------------------------------
# Logs each API request URL to stderr (does NOT log secrets)
# WORKATO_DEBUG=false