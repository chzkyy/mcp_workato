{
  "name": "mcp-workato",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server that exposes the Workato Platform API to Claude Desktop and other MCP clients.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-workato": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "lint": "tsc --noEmit",
    "ping": "node scripts/ping.mjs",
    "test": "node --test dist/test/*.test.js"
  },
  "keywords": [
    "mcp",
    "workato",
    "model-context-protocol",
    "claude",
    "automation",
    "integration"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
